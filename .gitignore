#Claude
CLAUDE.md

# Claude-specific artefacts stay local (skills, notes, settings)
.claude/

# Xcode project is generated from project.yml by XcodeGen — never commit it
*.xcodeproj
*.xcworkspace

# Build products and derived data
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM

# SwiftPM
# ⚠ Not `Packages/` — that ignores our own first-party local package. SPM's own
# checkouts live in .build/ and .swiftpm/, which are covered below.
.swiftpm/
.build/
Package.resolved

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# macOS
.DS_Store

# Generated by docs/implementation/backlog.py
docs/implementation/backlog.json

# Built by tools/interop — compiled helpers and soak output, not sources
tools/interop/qrdecode
tools/interop/ocrtext
tools/interop/winid
tools/interop/*-results.tsv
tools/interop/*.log

# The design canvas is a 2.2 MB generated file — the artboards with the whole
# editor baked in — and rebuilds from the .dc.html sources beside it. Those are
# the design; this is a build of it. See docs/design/opening-v2/README.md.
docs/design/opening-v2/pinpoint-opening-flow.html
